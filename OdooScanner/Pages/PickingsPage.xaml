<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OdooScanner.Pages.PickingsPage"
             Title="Stock Pickings">
    
    <Grid RowDefinitions="Auto, *">
        
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Padding="20" Spacing="10">
            <Label Text="Stock Pickings" 
                   FontSize="24" 
                   FontAttributes="Bold"/>
            <Button Text="Refresh"
                    Clicked="OnRefreshClicked"
                    HorizontalOptions="End"
                    WidthRequest="120"/>
            <ActivityIndicator x:Name="LoadingIndicator"
                             IsRunning="False"
                             IsVisible="False"
                             Color="{StaticResource Primary}"/>
        </VerticalStackLayout>

        <!-- Pickings List -->
        <CollectionView x:Name="PickingsCollectionView" 
                       Grid.Row="1"
                       Margin="10,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="10,5" Padding="15" CornerRadius="10">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" 
                              ColumnDefinitions="*,Auto">
                            
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding Name}"
                                   FontSize="18"
                                   FontAttributes="Bold"/>
                            
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding State}"
                                   FontSize="14"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center"/>
                            
                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{Binding PickingTypeId}"
                                   FontSize="14"
                                   TextColor="Gray"/>
                            
                            <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                   FontSize="12"
                                   TextColor="Gray">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Origin: "/>
                                        <Span Text="{Binding Origin}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            
                            <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                   FontSize="12"
                                   TextColor="Gray">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Scheduled: "/>
                                        <Span Text="{Binding ScheduledDate, StringFormat='{0:yyyy-MM-dd HH:mm}'}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        
    </Grid>
    
</ContentPage>
