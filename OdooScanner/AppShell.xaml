<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="OdooScanner.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:OdooScanner"
    xmlns:pages="clr-namespace:OdooScanner.Pages"
    Title="OdooScanner">

    <TabBar>
        <ShellContent
            Title="Scanner"
            Icon="dotnet_bot.png"
            ContentTemplate="{DataTemplate pages:ScannerPage}"
            Route="MainPage" />
        
        <ShellContent
            Title="Pickings"
            Icon="dotnet_bot.png"
            ContentTemplate="{DataTemplate pages:PickingsPage}"
            Route="PickingsPage" />
    </TabBar>

</Shell>
